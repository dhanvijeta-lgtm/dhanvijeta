import React, { useRef, useMemo, Suspense, useEffect, useState } from 'react';
import { Canvas, useFrame } from '@react-three/fiber';
import { Line } from '@react-three/drei';
import * as THREE from 'three';

const GLOBE_RADIUS = 4.2;

// Dense Land Regions for rich glowing continent patches
const LAND_REGIONS = [
  { lat: [25, 70], lon: [-130, -65], count: 1800 }, // North America
  { lat: [50, 72], lon: [-168, -128], count: 450 }, // Alaska
  { lat: [8, 25], lon: [-105, -77], count: 400 },   // Central America
  { lat: [-55, 12], lon: [-82, -34], count: 1400 },  // South America
  { lat: [36, 71], lon: [-12, 42], count: 1350 },    // Europe
  { lat: [-35, 37], lon: [-18, 52], count: 1350 },   // Africa
  { lat: [12, 42], lon: [25, 62], count: 600 },     // Middle East
  { lat: [5, 55], lon: [60, 145], count: 2500 },    // Asia
  { lat: [8, 35], lon: [68, 92], count: 900 },      // India / South Asia
  { lat: [-10, 25], lon: [95, 130], count: 750 },   // Southeast Asia
  { lat: [30, 46], lon: [128, 146], count: 400 },   // Japan
  { lat: [-44, -10], lon: [113, 154], count: 600 }, // Australia
  { lat: [60, 84], lon: [-55, -20], count: 220 },   // Greenland
  { lat: [-10, 6], lon: [95, 140], count: 450 },    // Indonesia
  { lat: [62, 72], lon: [15, 35], count: 280 }      // Scandinavia
];

function latLonToXYZ(lat, lon, radius) {
  const phi = (90 - lat) * (Math.PI / 180);
  const theta = (lon + 180) * (Math.PI / 180);
  return new THREE.Vector3(
    -radius * Math.sin(phi) * Math.cos(theta),
    radius * Math.cos(phi),
    radius * Math.sin(phi) * Math.sin(theta)
  );
}

// Generate dense emerald, cyan, gold glowing landmass particles + global ocean matrix nodes
function generateLandParticles(radius, isMobile = false) {
  const positions = [];
  const colors = [];
  const multiplier = isMobile ? 0.55 : 1.0;

  // 1. Luminous Continent Data Particles (Emerald Green, Cyan, Gold, White)
  LAND_REGIONS.forEach((region) => {
    const count = Math.floor(region.count * multiplier);
    for (let i = 0; i < count; i++) {
      const lat = region.lat[0] + Math.random() * (region.lat[1] - region.lat[0]);
      const lon = region.lon[0] + Math.random() * (region.lon[1] - region.lon[0]);
      const v = latLonToXYZ(lat, lon, radius + 0.08 + (Math.random() - 0.5) * 0.08);
      positions.push(v.x, v.y, v.z);

      const colorChoice = Math.random();
      if (colorChoice > 0.65) {
        // Neon Emerald Green (#00e5a0)
        colors.push(0.0, 0.9, 0.63);
      } else if (colorChoice > 0.35) {
        // Bright Cyan (#00e5ff)
        colors.push(0.0, 0.9, 1.0);
      } else if (colorChoice > 0.15) {
        // Luminous Gold (#f59e0b)
        colors.push(0.96, 0.65, 0.12);
      } else {
        // Pure White Core
        colors.push(1.0, 1.0, 1.0);
      }
    }
  });

  // 2. Global Ocean Matrix Grid (so no part of the sphere is ever black)
  const oceanGridCount = isMobile ? 500 : 1100;
  for (let i = 0; i < oceanGridCount; i++) {
    const phi = Math.acos(-1 + (2 * i) / oceanGridCount);
    const theta = Math.sqrt(oceanGridCount * Math.PI) * phi;
    const r = radius + 0.05 + (Math.random() - 0.5) * 0.04;
    positions.push(
      r * Math.cos(theta) * Math.sin(phi),
      r * Math.sin(theta) * Math.sin(phi),
      r * Math.cos(phi)
    );
    const isEmerald = i % 2 === 0;
    if (isEmerald) {
      colors.push(0.0, 0.85, 0.58);
    } else {
      colors.push(0.0, 0.82, 0.95);
    }
  }

  return {
    positions: new Float32Array(positions),
    colors: new Float32Array(colors)
  };
}

function generateAtmosphereParticles(radius, count = 700) {
  const positions = [];
  const colors = [];
  for (let i = 0; i < count; i++) {
    const phi = Math.acos(-1 + (2 * i) / count);
    const theta = Math.sqrt(count * Math.PI) * phi;
    positions.push(
      radius * Math.cos(theta) * Math.sin(phi),
      radius * Math.sin(theta) * Math.sin(phi),
      radius * Math.cos(phi)
    );
    const isGreen = i % 3 === 0;
    if (isGreen) {
      colors.push(0.0, 0.95, 0.65);
    } else {
      colors.push(0.0, 0.9, 1.0);
    }
  }
  return {
    positions: new Float32Array(positions),
    colors: new Float32Array(colors)
  };
}

function GoldenLandParticles({ radius, isMobile, hoverIntensity = 1 }) {
  const ref = useRef();
  const matRef = useRef();
  const { positions, colors } = useMemo(() => generateLandParticles(radius, isMobile), [radius, isMobile]);
  const scale = isMobile ? 0.85 : 1.0;

  useFrame((state) => {
    if (!matRef.current) return;
    const t = state.clock.getElapsedTime();
    matRef.current.opacity = Math.min(1.0, (0.92 + Math.sin(t * 1.8) * 0.08) * hoverIntensity);
  });

  return (
    <points ref={ref}>
      <bufferGeometry>
        <bufferAttribute
          attach="attributes-position"
          count={positions.length / 3}
          array={positions}
          itemSize={3}
        />
        <bufferAttribute
          attach="attributes-color"
          count={colors.length / 3}
          array={colors}
          itemSize={3}
        />
      </bufferGeometry>
      <pointsMaterial
        ref={matRef}
        size={0.14 * scale}
        sizeAttenuation={true}
        vertexColors={true}
        transparent={true}
        opacity={0.98}
        depthWrite={false}
        blending={THREE.AdditiveBlending}
      />
    </points>
  );
}

function AtmosphereParticles({ radius, isMobile }) {
  const ref = useRef();
  const { positions, colors } = useMemo(() => generateAtmosphereParticles(radius, isMobile ? 350 : 700), [radius, isMobile]);

  useFrame((_, delta) => {
    if (ref.current) ref.current.rotation.y += delta * 0.025;
  });

  return (
    <points ref={ref}>
      <bufferGeometry>
        <bufferAttribute
          attach="attributes-position"
          count={positions.length / 3}
          array={positions}
          itemSize={3}
        />
        <bufferAttribute
          attach="attributes-color"
          count={colors.length / 3}
          array={colors}
          itemSize={3}
        />
      </bufferGeometry>
      <pointsMaterial
        size={isMobile ? 0.05 : 0.07}
        sizeAttenuation={true}
        vertexColors={true}
        transparent={true}
        opacity={0.6}
        depthWrite={false}
        blending={THREE.AdditiveBlending}
      />
    </points>
  );
}

function OrbitArc({ radius, rotation, speed, color, opacity = 0.4 }) {
  const groupRef = useRef();
  const points = useMemo(() => {
    const pts = [];
    for (let i = 0; i <= 120; i++) {
      const t = (i / 120) * Math.PI * 1.85;
      pts.push(
        new THREE.Vector3(
          Math.cos(t) * radius,
          Math.sin(t) * radius * 0.12,
          Math.sin(t) * radius * 0.92
        )
      );
    }
    return pts;
  }, [radius]);

  useFrame((_, delta) => {
    if (groupRef.current) groupRef.current.rotation.y += delta * speed;
  });

  return (
    <group ref={groupRef} rotation={rotation}>
      <Line points={points} color={color} lineWidth={1.6} transparent opacity={opacity} />
    </group>
  );
}

// 3D Integrated Financial Candlestick World inside/over the Globe horizon
function GlobeIntegratedCandlesticks({ radius }) {
  const groupRef = useRef();
  const candleCount = 14;

  const candleData = useMemo(() => {
    const items = [];
    for (let i = 0; i < candleCount; i++) {
      const angle = (i / candleCount) * Math.PI * 1.4 - Math.PI * 0.7;
      const isGreen = i % 4 !== 1;
      const height = 0.35 + Math.sin(i * 1.2) * 0.25 + Math.random() * 0.2;
      const r = radius * 1.08;
      const x = Math.cos(angle) * r;
      const y = (i - candleCount / 2) * 0.25 + Math.sin(i * 0.8) * 0.4;
      const z = Math.sin(angle) * r * 0.85;

      items.push({
        id: i,
        pos: [x, y, z],
        height,
        isGreen,
        color: isGreen ? '#00e5a0' : '#ff4d4d',
      });
    }
    return items;
  }, [radius]);

  useFrame((state, delta) => {
    if (groupRef.current) {
      groupRef.current.rotation.y += delta * 0.04;
    }
  });

  return (
    <group ref={groupRef}>
      {candleData.map((c) => (
        <group key={c.id} position={c.pos}>
          {/* Candlestick Wick */}
          <mesh position={[0, 0, 0]}>
            <cylinderGeometry args={[0.012, 0.012, c.height * 2.2, 8]} />
            <meshBasicMaterial color={c.color} transparent opacity={0.8} />
          </mesh>
          {/* Candlestick Body */}
          <mesh position={[0, 0, 0]}>
            <boxGeometry args={[0.12, c.height, 0.12]} />
            <meshStandardMaterial
              color={c.color}
              emissive={c.color}
              emissiveIntensity={0.6}
              roughness={0.2}
              metalness={0.8}
              transparent
              opacity={0.85}
            />
          </mesh>
        </group>
      ))}
    </group>
  );
}

function GlobeScene({ isMobile, isHovered = false }) {
  const globeRef = useRef();
  const radius = isMobile ? GLOBE_RADIUS * 0.85 : GLOBE_RADIUS;

  // Initial rotation preset to 3.4 rad facing Europe, Asia, Africa, India immediately from frame 0
  const rotY = useRef(3.4);

  useFrame((state, delta) => {
    if (!globeRef.current) return;
    const speedMult = isHovered ? 0.09 : 0.06;
    rotY.current += delta * speedMult;
    globeRef.current.rotation.y = rotY.current;
    globeRef.current.rotation.x = Math.sin(state.clock.getElapsedTime() * 0.15) * 0.06 - 0.12;
  });

  return (
    <group ref={globeRef}>
      {/* Semi-transparent dark inner sphere body so glowing inner core & grid lines show through */}
      <mesh>
        <sphereGeometry args={[radius * 0.985, 48, 48]} />
        <meshBasicMaterial color="#030814" transparent opacity={0.45} />
      </mesh>

      {/* Inner Glowing Emerald & Gold Core Energy Mesh */}
      <mesh>
        <sphereGeometry args={[radius * 0.94, 32, 32]} />
        <meshBasicMaterial color="#00e5a0" transparent opacity={0.14} blending={THREE.AdditiveBlending} />
      </mesh>

      {/* Outer 3D Atmospheric Glowing Emerald Rim Shells */}
      <mesh>
        <sphereGeometry args={[radius * 1.025, 48, 48]} />
        <meshBasicMaterial color="#00e5a0" transparent opacity={0.16} blending={THREE.AdditiveBlending} />
      </mesh>
      <mesh>
        <sphereGeometry args={[radius * 1.065, 48, 48]} />
        <meshBasicMaterial color="#00e5ff" transparent opacity={0.09} blending={THREE.AdditiveBlending} />
      </mesh>

      {/* Latitude / Longitude Wireframe Grid */}
      <mesh>
        <sphereGeometry args={[radius * 1.002, 36, 36]} />
        <meshBasicMaterial color="#00e5a0" wireframe transparent opacity={0.22} />
      </mesh>

      {/* Luminous Landmass Particles */}
      <GoldenLandParticles radius={radius} isMobile={isMobile} hoverIntensity={isHovered ? 1.25 : 1.0} />

      {/* Cyan & Emerald Atmosphere Dots */}
      <AtmosphereParticles radius={radius * 1.01} isMobile={isMobile} />

      {/* Integrated 3D Candlesticks */}
      <GlobeIntegratedCandlesticks radius={radius} />

      {/* Cyan, Emerald & Gold Orbit Arcs */}
      <OrbitArc
        radius={radius * 1.35}
        rotation={[0.4, 0.2, 0.15]}
        speed={0.08}
        color="#00E5A0"
        opacity={0.6}
      />
      <OrbitArc
        radius={radius * 1.48}
        rotation={[0.8, -0.3, 0.5]}
        speed={-0.05}
        color="#00E5FF"
        opacity={0.45}
      />
      <OrbitArc
        radius={radius * 1.22}
        rotation={[-0.5, 0.6, -0.2]}
        speed={0.06}
        color="#F59E0B"
        opacity={0.4}
      />
    </group>
  );
}

function GlobeCanvas({ isMobile, isHovered = false }) {
  const [isTabVisible, setIsTabVisible] = useState(true);

  useEffect(() => {
    const handleVisibilityChange = () => {
      setIsTabVisible(document.visibilityState === 'visible');
    };
    document.addEventListener('visibilitychange', handleVisibilityChange);
    return () => document.removeEventListener('visibilitychange', handleVisibilityChange);
  }, []);

  if (!isTabVisible) return null;

  return (
    <Canvas
      camera={{ position: [0, 0.5, 13], fov: 42 }}
      gl={{ antialias: true, alpha: true, powerPreference: 'high-performance' }}
      dpr={isMobile ? 1 : Math.min(window.devicePixelRatio, 1.5)}
    >
      <ambientLight intensity={0.5} />
      <pointLight position={[8, 6, 10]} intensity={1.8} color="#00e5a0" />
      <pointLight position={[-6, -4, 8]} intensity={1.2} color="#00E5FF" />
      <pointLight position={[0, -8, -5]} intensity={0.8} color="#f59e0b" />
      <Suspense fallback={null}>
        <GlobeScene isMobile={isMobile} isHovered={isHovered} />
      </Suspense>
    </Canvas>
  );
}

export function DigitalGlobe({ pointer = { x: 0, y: 0 } }) {
  const [isHovered, setIsHovered] = useState(false);
  const isMobile = typeof window !== 'undefined' && window.innerWidth < 768;

  return (
    <div
      className="absolute inset-0 z-[1] pointer-events-auto overflow-hidden"
      onMouseEnter={() => setIsHovered(true)}
      onMouseLeave={() => setIsHovered(false)}
    >
      {/* 1. INTENSE EMERALD GREEN AMBIENT RADIAL GLOW & VOLUMETRIC ATMOSPHERE BEHIND GLOBE */}
      <div
        className="absolute top-[-10%] left-[4%] sm:left-[10%] w-[105vw] sm:w-[90vw] h-[90vh] pointer-events-none transition-opacity duration-500"
        style={{
          background:
            'radial-gradient(circle at 48% 42%, rgba(0, 229, 160, 0.48) 0%, rgba(0, 229, 255, 0.25) 28%, rgba(245, 158, 11, 0.12) 52%, transparent 75%)',
          filter: `blur(35px) drop-shadow(0 0 ${isHovered ? '120px' : '90px'} rgba(0, 229, 160, 0.8))`,
          transform: `translate(${pointer.x * 0.6}px, ${pointer.y * 0.6}px)`
        }}
      />

      {/* 2. SECONDARY INTENSE CYAN & GOLD RIM GLOW AURA */}
      <div
        className="absolute top-[-4%] left-[8%] sm:left-[14%] w-[96vw] sm:w-[80vw] h-[80vh] pointer-events-none"
        style={{
          background:
            'radial-gradient(circle at 52% 46%, rgba(0, 229, 255, 0.38) 0%, rgba(0, 229, 160, 0.18) 36%, transparent 68%)',
          filter: 'blur(40px)',
          transform: `translate(${pointer.x * 0.8}px, ${pointer.y * 0.8}px)`
        }}
      />

      {/* 3. DYNAMIC PULSING EMERALD HALO CORE RINGS */}
      <div
        className="absolute top-[4%] left-[20%] sm:left-[26%] w-[60vw] sm:w-[46vw] h-[60vh] sm:h-[55vh] rounded-full pointer-events-none animate-pulse-slow"
        style={{
          background: 'radial-gradient(circle, rgba(0, 229, 160, 0.45) 0%, rgba(0, 229, 255, 0.22) 45%, transparent 80%)',
          filter: 'blur(45px)'
        }}
      />

      {/* Three.js globe canvas */}
      <div
        className="absolute top-[-2%] left-[5%] sm:left-[12%] w-[95vw] sm:w-[78vw] lg:w-[68vw] h-[68vh] sm:h-[72vh]"
        style={{
          transform: `translate(${pointer.x * 1.2}px, ${pointer.y * 1.2}px) rotateX(${pointer.y * -0.2}deg) rotateY(${pointer.x * 0.4}deg)`
        }}
      >
        <GlobeCanvas isMobile={isMobile} isHovered={isHovered} />
      </div>
    </div>
  );
}

export default DigitalGlobe;
